{
    "name": "ts-cck-analyzer",
    "version": "1.0.0",
    "description": "ClusterScript TypeScript analyzer with component constraint validation",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "bin": {
        "ts-analyzer": "dist/cli.js"
    },
    "scripts": {
        "build": "tsc",
        "analyze": "node dist/cli.js",
        "dev": "tsc --watch",
        "test": "vitest run",
        "verify": "npm run build && npm run test",
        "update-types": "node ./scripts/update-types.js"
    },
    "keywords": [
        "cluster",
        "clusterscript",
        "typescript",
        "static-analysis",
        "unity-components"
    ],
    "author": "",
    "dependencies": {
        "@iarna/toml": "^2.2.5",
        "typescript": "^6.0.3"
    },
    "devDependencies": {
        "@types/node": "^26.1.1",
        "vitest": "^4.1.10"
    }
}